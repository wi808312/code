class TrotGaitController(GaitController):
    def __init__(self, default_stance, stance_time, swing_time, time_step, use_imu):
        self.use_imu = use_imu #멈춘 상태
        self.use_button = True #버튼 사용
        self.autoRest = True #자동 휴식
        self.trotNeeded = True #움직이는 상태 
        
        leg = LegParam() #다리 위치 값

        contact_phases = np.array([[1, 1, 1, 0],  # 0: Leg swing
                                   [1, 0, 1, 1],  # 1: Moving stance forward
                                   [1, 0, 1, 1],  
                                   [1, 1, 1, 0]])

        z_error_constant = 0.02 * 4    # This constant determines how fast we move
                                       # toward the goal in the z direction

        z_leg_lift = leg.gait.z_leg_lift #다리 들 때 z값

        super().__init__(stance_time, swing_time, time_step, contact_phases, default_stance)

        self.max_x_vel = leg.gait.max_x_vel #gait의 max_x_vel 호출
        self.max_y_vel = leg.gait.max_y_vel #gait의 max_y_vel 호출
        self.max_yaw_rate = leg.gait.max_yaw_rate #gait의 max_z_vel 호출
        
        self.swingController = TrotSwingController(self.stance_ticks, self.swing_ticks, self.time_step,
                                                   self.phase_length, z_leg_lift, self.default_stance)
        #swing값 전달
        self.stanceController = TrotStanceController(self.phase_length, self.stance_ticks, self.swing_ticks,
                                                     self.time_step, z_error_constant)
        #stance값 전달
        # TODO : 게인값 조율
        self.pid_controller = PID_controller(0., 0., 0.) #self.pid_controller 정의

    def updateStateCommand(self, msg, state, command):
        command.cmd_vel[0] = msg.linear.x /1.5 * self.max_x_vel #cmd_vel에 값을 전송
        command.cme_vel[1] = msg.linear.y /1.5 * self.max_y_vel #여긴 cme네? 오타
        command.cmd_yaw_rate = msg.angular.z * self.max_yaw_rate #cmd_yaw_rate에 값을 전송 

