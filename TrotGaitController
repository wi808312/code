    def step(self, state, command):
        if self.autoRest: #자동 휴식
            if command.cmd_vel[0] == 0 and command.cmd_vel[1] == 0 and command.cmd_yaw_rate ==0: #멈추면
                if state.ticks % (2*self.phase_length) ==0:
                    self.trotNeeded = False #멈춤
            else:
                self.trotNeeded = True
        if self.trotNeeded: #움직이고 있으면
            contact_modes = self.contacts(state.ticks) #연결 모드르 가져옴

            new_foot_locations = np.zeros((3,4))
            for leg_index in range(4):
                contact_modes = contact_modes[leg_index] #다리별 연결 상태
                if contact_modes ==1: #연결되어 있다면 
                    new_location = self.stanceController.next_foot_location(leg_index, state, command) #스탠스
                else:
                    swing_proportion = float(self.subphase_ticks(state.ticks))/float(self.swing_ticks) #스윙

                    new_location = self.swingController.next_foot_location(swing_proportion, leg_index, state, command)
                new_foot_locations[:, leg_index] = new_location #다리 위치
            
            # imu compensation
            if self.use_imu: #멈춰있다면
                compensation = self.pid_controller.run(state.imu_roll, state.imu_pitch) #보정
                roll_compensation = -compensation[0] #roll보정
                pitch_compensation = -compensation[1] #pitch보정

                rot = rotxyz(roll_compensation, pitch_compensation, 0) #보정값 적용
                new_foot_locations = np.matmul(rot, new_foot_locations) #위치 변경
            state.ticks +=1 #틱값 갱신
            return new_foot_locations
        else: #안 움직이면
            temp = self.default_stance #초기 자세
            temp[2] = [command.robot_height]*4 #로봇의 높이
            return temp
    def run(self, state, command): 
        state.foot_locations = self.step(state, command) #명령에 따라 발위치 조정
        state.robot_height = command.robot_height #로봇의 높이 조정

        return state.foot_locations


        
class TrotSwingController(object):
    def __init__(self, stance_ticks, swing_ticks, time_step, phase_length, z_leg_lift, default_stance):
        self.stance_ticks = stance_ticks #stance의 시간
        self.swing_ticks = swing_ticks #swing의 시간
        self.time_step = time_step #여전히 모르겠음
        self.phase_length = phase_length #페이즈의 주기
        self.z_leg_lift = z_leg_lift #다리 들 때의 z값
        self.default_stance = default_stance #초기 스탠스

    def raibert_touchdwon_location(self, leg_index, command ): #down으로 변경
        delta_pos_2d = command.cmd_vel * self.phase_length * self.time_step #이차원에서의 위치
        delta_pos = np.array([delta_pos_2d[0], delta_pos_2d[1], 0]) #위치

        theta = self.stance_ticks * self.time_step * command.cmd_yaw_rate #각도 변경
        rotation = rotz(theta) #컴퓨터 값으로 변경

        return np.matmul(rotation, self.default_stance[:, leg_index]) + delta_pos
    
    def swing_height(self, swing_phase):
        if swing_phase < 0.5: #0.5까지는 들고
            swing_height_ = swing_phase / 0.5 * self.z_leg_lift #높이 증가
        else: # 넘으면 내려놓기
            swing_height_ = self.z_leg_lift * (1 - (swing_phase - 0.5) / 0.5) #높이 감소
        return swing_height_
    
    def next_foot_location(self, swing_prop, leg_index, state, command):
        assert swing_prop >= 0 and swing_prop <= 1
        foot_location = state.foot_locations[:, leg_index] #다리 위치 변경
        swing_height_ = self.swing_height(swing_prop) #swing 높이
        touchdown_location = self.raibert_touchdown_location(leg_index, command) #touch_down의 위치 변경

        time_left = self.time_step* self.swing_ticks * (1.0 - swing_prop) #남은 시간 계산
        
        velocity = (touchdown_location - foot_location) / float(time_left) *\
             np.array([1, 1, 0]) #속도 계산

        delta_foot_location = velocity * self.time_step #발 위치 변화량
        z_vector = np.array([0, 0, swing_height_ + command.robot_height]) #z의 벡터값을 swing 높이랑 robot 위치 목표를 더한 값으로 설정
        return foot_location * np.array([1, 1, 0]) + z_vector + delta_foot_location
    
class TrotStanceController(object): 
    def __init__(self,phase_length, stance_ticks, swing_ticks, time_step, z_error_constant):
        self.phase_length = phase_length #페이즈 주기
        self.stance_ticks = stance_ticks #스탠스의 틱
        self.swing_ticks = swing_ticks #스윙의 틱
        self.time_step = time_step #여전히 모르겠음
        self.z_error_constant = z_error_constant #오류


    def position_delta(self, leg_index, state, command): 
        z = state.foot_locations[2, leg_index] #각 다리별 z값

        step_dist_x = command.cmd_vel[0] *\
                      (float(self.phase_length)/self.swing_ticks)
        #x의 거리
        step_dist_y = command.cmd_vel[1] *\
                      (float(self.phase_length)/self.swing_ticks)
        #y의 거리
        velocity = np.array([-(step_dist_x/4)/(float(self.time_step)*self.stance_ticks), 
                             -(step_dist_y/4)/(float(self.time_step)*self.stance_ticks), 
                             1.0 / self.z_error_constant * (state.robot_height - z)])
        #속도 계산
        delta_pos = velocity * self.time_step #위치 변화
        delta_ori = rotz(-command.cmd_yaw_rate * self.time_step) #각도 변화
        return (delta_pos, delta_ori)
    
    def next_foot_location(self, leg_index, state, command):
        foot_location = state.foot_locations[:, leg_index] #현재  다리 위치
        (delta_pos, delta_ori) = self.position_delta(leg_index, state, command) #변화량
        next_foot_location = np.matmul(delta_ori, foot_location) + delta_pos #다음 발 위치
        return next_foot_location

        



